# =============================================================================
# AtlasBank Prompt-Injection Benchmark - environment template
# =============================================================================
#
# Copy this file to ".env" and fill in values ONLY if you want to run against a
# real model. The project runs fully offline by default and needs none of these.
#
#     cp .env.example .env
#
# None of these variables are required for the default replay (offline) mode.
# -----------------------------------------------------------------------------

# Which model backend to use:
#   replay     -> offline, deterministic, no key needed (DEFAULT)
#   anthropic  -> hosted Anthropic model (requires ANTHROPIC_API_KEY below)
#   ollama     -> local open-source model via a running Ollama server
ATLASBANK_PROVIDER=replay

# Required ONLY when ATLASBANK_PROVIDER=anthropic (or for a live LLM judge).
# Do NOT commit your real key. This placeholder is intentionally not a real key.
ANTHROPIC_API_KEY=

# --- Optional overrides (sensible defaults exist in src/config.py) -----------

# Exact hosted model identifier. Confirm the current value against the provider's
# documentation at the time of your live run, and record it in the REPORT.
# ATLASBANK_ANTHROPIC_MODEL=claude-sonnet-4-6

# Local model name for the cross-model study (must be pulled in Ollama first).
# ATLASBANK_OLLAMA_MODEL=llama3.1:8b

# Model used by the independent judge verifier (defaults to the Anthropic model).
# ATLASBANK_JUDGE_MODEL=claude-sonnet-4-6

# Number of repetitions per configuration in the ablation study (default 3).
# ATLASBANK_ABLATION_RUNS=3
